# ==========================================
# SkyCrop – .gitignore
# Vite (React) + Node.js Backend + Supabase + GEE
# ==========================================

# ─── Dependencias ──────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build & Output ────────────────────────────
dist/
dist-ssr/
build/
out/
.vercel/
.output/

# ───  VARIABLES DE ENTORNO Y SECRETOS ────────
# Nunca subir archivos con claves reales al repositorio.
# Usar .env.example como referencia pública (sin valores reales).

# Frontend (Vite)
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.staging
.env.staging.local
.env.test
.env.test.local
.env.*.local
.env.*

# Backend
backend/.env
backend/.env.local
backend/.env.*
backend/api/
# ─── Claves de Servicio (Google / GCP / GEE) ───
# Credenciales de Service Account de Google Earth Engine
# y cualquier JSON de clave privada generado desde GCP
*.json.key
service-account*.json
gee-credentials*.json
*-service-account.json
*credentials*.json
*-key.json
*.pem
*.p12
*.pfx
*.key
# ─── Supabase ───────────────────────────────────
# Las claves ANON y SERVICE ROLE deben vivir solo en .env
# Las migraciones SÍ se versionan (fuente de verdad del schema, p. ej. 050).
# No versionar archivos de configuración exportados de Supabase CLI
supabase/.branches/
supabase/config.toml
supabase/migrations_v1_backup/
database/migrations
# ─── Logs ───────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Caché de herramientas ──────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.turbo/
*.tsbuildinfo

# ─── IDEs y Editores ────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# ─── OS / Sistema ───────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Testing ────────────────────────────────────
coverage/
*.lcov
.nyc_output/
# Reportes E2E generados (se retienen localmente, no se versionan)
tests/e2e/reports/SKYCROP_E2E_REPORT_*
tests/e2e/reports/SKYCROP_E2E_RESULTADO_COMPLETO_*
tests/e2e/real/reports/SKYCROP_E2E_REAL_SUPABASE_REPORT_*
tests/e2e/real/reports/SKYCROP_E2E_REAL_SUPABASE_RESULTADO_COMPLETO_*
!tests/e2e/reports/.gitkeep

# ─── Temporales y Scratchpads ───────────────────
scratch/
tmp/
temp/
*.tmp
*.bak
*.orig

